local function CommF(...)
    local remotes = RS:FindFirstChild("Remotes")
    if remotes then
        local comm = remotes:FindFirstChild("CommF_")
        if comm then
            local success, res = pcall(comm.InvokeServer, comm, ...)
            if success then return res end
        end
    end
end

