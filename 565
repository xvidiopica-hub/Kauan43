    -- Farm
    local lastValidPos = nil
    local lastQuestTry = 0
    local currentMob = nil

    RunService.Heartbeat:Connect(function(deltaTime)
        if not Config.AutoFarm or Config.Collecting then return end

        pcall(function()
            local char = LP.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end

            local qData = GetCurrentQuestData()
            local gui = LP.PlayerGui:FindFirstChild("Main")
            local questFrame = gui and gui:FindFirstChild("Quest")
            local hasQuest = questFrame and questFrame.Visible
            local wrongQuest = false

            if hasQuest then
                local container = questFrame:FindFirstChild("Container")
                local title = container and container:FindFirstChild("Title")
                if title and not title.Text:find(qData.Mob) then
                    wrongQuest = true
                end
            end

            local targetPos = nil

            if not hasQuest or wrongQuest then
                if wrongQuest then CommF("AbandonQuest") end
                local npcCF = NPCPoints[qData.Mob] or SpawnPoints[qData.Mob]
                if npcCF then
                    targetPos = npcCF.Position + Vector3.new(0, 5, 0)
                    if (root.Position - targetPos).Magnitude < 15 and (tick() - lastQuestTry) > 1.8 then
                        lastQuestTry = tick()
                        CommF("StartQuest", qData.Name, qData.Level)
                    end
                end
            else
                if not (currentMob and currentMob.Parent and currentMob:FindFirstChild("Humanoid") and currentMob.Humanoid.Health > 0) then
                    currentMob = nil
                    local mob = FindMob(qData.Mob)
                    if mob then currentMob = mob end
                end

                if currentMob and currentMob:FindFirstChild("HumanoidRootPart") then
                    local mobRoot = currentMob.HumanoidRootPart
                    targetPos = mobRoot.Position + Vector3.new(0, Config.Height, 0)
                    lastValidPos = targetPos
                else
                    local spawnCF = SpawnPoints[qData.Mob]
                    if spawnCF then
                        targetPos = spawnCF.Position + Vector3.new(0, Config.Height, 0)
                    elseif lastValidPos then
                        targetPos = lastValidPos
                    else
                        targetPos = root.Position
                    end
                end
            end

            if targetPos then
                local currentPos = root.Position
                local direction = targetPos - currentPos
                local distance = direction.Magnitude

                if distance > 5 then
                    local flySpeed = Config.FlySpeed * deltaTime
                    if flySpeed > distance then flySpeed = distance end
                    root.Velocity = Vector3.zero
                    root.CFrame = CFrame.new(currentPos + direction.Unit * flySpeed)
                else
                    root.Velocity = Vector3.zero
                    if hasQuest and not wrongQuest and currentMob and currentMob:FindFirstChild("HumanoidRootPart") then
                        root.CFrame = currentMob.HumanoidRootPart.CFrame * CFrame.new(0, Config.Height, 0)
                    else
                        root.CFrame = CFrame.new(targetPos)
                    end
                end
            end
        end)
    end)

