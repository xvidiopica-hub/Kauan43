local function GetCurrentQuestData()
    local list = Quests[GetSea()] or Quests[1]
    for _, q in ipairs(list) do
        if Level >= q[1] and Level <= q[2] then
            return {Name = q[3], Level = q[4], Mob = q[5]}
        end
    end
    local last = list[#list]
    return {Name = last[3], Level = last[4], Mob = last[5]}
end

local function FindMob(name)
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end
    for _, v in ipairs(folder:GetChildren()) do
        if v.Name == name then
            local hum = v:FindFirstChildOfClass("Humanoid")
            local root = v:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                return v, root
            end
        end
    end
end

local function EquipWeapon()
    local char = LP.Character
    if not char or not char:FindFirstChild("Humanoid") then return end
    local target = Config.AttackMode
    for _, item in ipairs(LP.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            local tt = item.ToolTip
            if item:FindFirstChild("ToolTip") then tt = item.ToolTip.Value end
            if target == "Melee" and (tt == "Melee" or item.Name:lower():find("combat") or item.Name:lower():find("step") or item.Name:lower():find("fist")) then
                char.Humanoid:EquipTool(item)
                return
            elseif target == "Sword" and (tt == "Sword" or item.Name:lower():find("sword") or item.Name:lower():find("katana") or item.Name:lower():find("bisento")) then
                char.Humanoid:EquipTool(item)
                return
            elseif target == "Fruit" and (tt == "Blox Fruit" or item.Name:lower():find("fruit")) then
                char.Humanoid:EquipTool(item)
                return
            end
        end
    end
end

