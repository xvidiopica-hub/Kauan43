                        for _, chest in ipairs(chests) do
                            if chest and chest.Parent then
                                root.CFrame = chest.CFrame + Vector3.new(0, 2.5, 0)
                                task.wait(0.7)
                            end
                        end
                        task.wait(0.4)
                        Config.Collecting = false
                    end
                end
            end)
        end
    end)

    -- ==========================================================
    -- FRUIT ESP + AUTO STORE
    -- ==========================================================
    local ESPFolder = Instance.new("Folder")
    ESPFolder.Name = "KauanzinhoFruitESP"
    ESPFolder.Parent = ProtectedGui

    local function ClearFruitESP()
        for _, v in pairs(ESPFolder:GetChildren()) do
            v:Destroy()
        end
    end

    local function CreateFruitESP(fruit)
        if not fruit or not fruit:FindFirstChild("Handle") then return end
        local billboard = Instance.new("BillboardGui")
        billboard.Name = fruit.Name
        billboard.Adornee = fruit.Handle
        billboard.Size = UDim2.new(0, 130, 0, 40)
        billboard.StudsOffset = Vector3.new(0, 2.8, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = ESPFolder

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = fruit.Name
        label.TextColor3 = Color3.fromRGB(0, 255, 120)
        label.TextStrokeTransparency = 0.3
        label.TextScaled = true
        label.Font = Enum.Font.GothamBold
        label.Parent = billboard
    end

    task.spawn(function()
        while task.wait(1.5) do
            pcall(function()
                -- Auto Store
                if Config.AutoStore then
                    for _, tool in pairs(LP.Backpack:GetChildren()) do
                        if tool:IsA("Tool") and (string.find(tool.Name, "Fruit") or (tool:FindFirstChild("ToolTip") and tool.ToolTip.Value == "Blox Fruit")) then
                            CommF("StoreFruit")
                            break
                        end
                    end
                    local char = LP.Character
                    if char then
                        for _, tool in pairs(char:GetChildren()) do
                            if tool:IsA("Tool") and (string.find(tool.Name, "Fruit") or (tool:FindFirstChild("ToolTip") and tool.ToolTip.Value == "Blox Fruit")) then
                                CommF("StoreFruit")
                                break
                            end
                        end
                    end
                end

                -- Fruit ESP
                ClearFruitESP()
                if Config.FruitESP then
                    for _, v in pairs(workspace:GetChildren()) do
                        if v:IsA("Tool") and v:FindFirstChild("Handle") then
                            CreateFruitESP(v)
                        end
                    end
                    for _, folder in pairs(workspace:GetChildren()) do
                        if folder:IsA("Folder") or folder:IsA("Model") then
                            for _, v in pairs(folder:GetChildren()) do
                                if v:IsA("Tool") and v:FindFirstChild("Handle") then
                                    CreateFruitESP(v)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end)
end

